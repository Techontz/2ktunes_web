# Base URL of the 2kTunes Laravel API (no trailing slash).
# The frontend calls ${VITE_API_URL}/api/... with Sanctum bearer tokens.
# REQUIRED for production: `npm run build` fails without it (set
# ALLOW_MISSING_API_URL=1 to override) and warns if it points at localhost.
# Production example: VITE_API_URL="https://api.2ktunes.com"
VITE_API_URL="http://127.0.0.1:8000"

# Optional. Google OAuth web client ID. When set, "Continue with Google" is
# shown and uses Google Identity Services; the ID token is posted to
# POST /api/google-login as { id_token }. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=""

# Optional. Address the public contact form composes its email to.
# Defaults to support@2ktunes.com.
VITE_CONTACT_EMAIL=""
