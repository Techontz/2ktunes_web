# Public, non-secret build setting committed on purpose: every production build
# (Vercel production and preview, or `npm run build` locally) talks to the live
# 2kTunes API. A VITE_API_URL set in the Vercel dashboard or the shell overrides
# this file. Never put secrets in VITE_* variables: they ship to the browser.
VITE_API_URL="https://api.2ktunes.com"
